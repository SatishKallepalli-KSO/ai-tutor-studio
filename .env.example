# Auth
JWT_SECRET=change-me-in-production
JWT_HOURS=168

# Comma-separated emails that get product admin dashboard access
ADMIN_EMAILS=you@example.com

# Optional — richer LLM coaching (Pro path)
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4o-mini

# Public app URL (Stripe success/cancel redirects)
APP_URL=http://localhost:5173

# Stripe subscriptions (https://dashboard.stripe.com)
# Create Product "AI Tutor Studio Pro" with monthly + yearly prices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# When Stripe is configured, set true only for staging demos
ALLOW_DEMO_UPGRADE=false

# Optional Postgres on Render; defaults to local SQLite
# DATABASE_URL=postgresql://user:pass@host/db
