# Auth
JWT_SECRET=change-me-in-production
JWT_HOURS=168

# Comma-separated emails that get product admin dashboard (/admin)
ADMIN_EMAILS=you@example.com

# AI coaching — OpenAI (production uses gpt-4o-mini)
# Without a key or credits, feedback falls back to local-rubric
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4o-mini

# Public app URL (Stripe success/cancel redirects)
APP_URL=http://localhost:5173
# Production: https://ai-tutor-studio.onrender.com

# Stripe subscriptions (https://dashboard.stripe.com)
# Create Product "AI Tutor Studio Pro" with monthly + yearly prices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# true = Demo Pro upgrade (current production until Stripe is live)
# false = require real Stripe checkout
ALLOW_DEMO_UPGRADE=false

# Postgres — Neon Free pooled URL in production (see docs/product/DATABASE.md)
# Omit for local SQLite under apps/api/data/tutor.db
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/aitutor?sslmode=require
